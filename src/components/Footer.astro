---
import { BUSINESS_INFO, SERVICES, ALL_STATES } from '../data/siteData';
---

<footer class="site-footer" style="background:#020617;color:#94a3b8;border-top:1px solid #1e293b;font-size:0.85rem">
  <!-- Top Feature Highlight Strip -->
  <div style="border-bottom:1px solid rgba(30,41,59,0.8);background:rgba(15,23,42,0.6)">
    <div class="container" style="padding-top:2rem;padding-bottom:2rem">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:1.5rem;align-items:center">
        <!-- Feature 1 -->
        <div style="display:flex;align-items:center;gap:1rem">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.3);color:#60a5fa;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            </svg>
          </div>
          <div>
            <h4 style="color:#ffffff;font-size:1rem;font-weight:700;margin:0 0 0.2rem">Nationwide Water Damage Assistance</h4>
            <p style="color:#94a3b8;font-size:0.78rem;line-height:1.4;margin:0">Certified emergency water extraction & structural drying specialists serving all 50 states.</p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div style="display:flex;align-items:center;gap:1rem">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#34d399;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <h4 style="color:#ffffff;font-size:1rem;font-weight:700;margin:0 0 0.2rem">Direct Phone Inquiries</h4>
            <p style="color:#94a3b8;font-size:0.78rem;line-height:1.4;margin:0">Call directly to describe symptoms, request urgent dispatch, or verify insurance claim assistance.</p>
          </div>
        </div>

        <!-- Feature 3: Call CTA -->
        <div style="display:flex;justify-content:flex-start;md:justify-content:flex-end">
          <a href={BUSINESS_INFO.phoneTel} class="ref-call-btn" style="width:100%;max-width:280px;text-align:center" aria-label="Call (866) 751-9896 for immediate water restoration">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{BUSINESS_INFO.phoneFormatted}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Directory Columns -->
  <div class="container" style="padding-top:3.5rem;padding-bottom:3.5rem">
    <div style="display:grid;grid-template-columns:2fr 1.2fr 1.2fr 1.2fr;gap:2.5rem" class="footer-columns-wrap">
      <!-- Col 1: Brand -->
      <div style="display:flex;flex-direction:column;gap:1rem">
        <a href="/" class="brand-logo" style="color:#ffffff;text-decoration:none">
          <div class="brand-icon" style="background:#2563eb">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
          <div class="brand-text" style="color:#ffffff">
            Rapid Water <span style="color:#60a5fa">Rescue Pros</span>
          </div>
        </a>
        <p style="font-size:0.82rem;line-height:1.65;color:#94a3b8;max-width:380px;margin:0">
          Rapid Water Rescue Pros provides emergency water extraction, flood damage mitigation, and structural drying services for residential and commercial properties across the United States. Available 24 hours a day, 365 days a year.
        </p>
        <div style="margin-top:0.5rem">
          <a href={BUSINESS_INFO.phoneTel} style="color:#ffffff;font-weight:700;font-size:1.05rem;display:inline-flex;align-items:center;gap:0.5rem;text-decoration:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#60a5fa"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Call {BUSINESS_INFO.phoneFormatted}</span>
          </a>
          <div style="font-size:0.75rem;color:#64748b;margin-top:0.25rem">Toll-free 24/7 customer line</div>
        </div>
      </div>

      <!-- Col 2: Core Services -->
      <div>
        <h5 style="color:#ffffff;font-size:0.78rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1rem">Restoration Services</h5>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">
          {SERVICES.slice(0, 5).map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} style="color:#94a3b8;text-decoration:none;font-size:0.82rem;transition:color 0.15s ease" class="hover:text-blue-400">
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/services/" style="color:#60a5fa;font-weight:700;font-size:0.82rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem">
              <span>All 8 Services</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div>
        <h5 style="color:#ffffff;font-size:0.78rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1rem">Helpful Resources</h5>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">
          <li><a href="/blog/emergency-water-extraction-guide/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Water Extraction Guide</a></li>
          <li><a href="/blog/water-damage-insurance-claim-process/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Insurance Claims Guide</a></li>
          <li><a href="/blog/signs-of-water-heater-failure/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Water Heater Failure Signs</a></li>
          <li><a href="/blog/structural-drying-timeline/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Structural Drying Timeline</a></li>
          <li><a href="/about-us/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">About Rapid Water Rescue</a></li>
          <li><a href="/contact-us/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Contact & Dispatch</a></li>
        </ul>
      </div>

      <!-- Col 4: Top States -->
      <div>
        <h5 style="color:#ffffff;font-size:0.78rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:1rem">Popular Service Areas</h5>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">
          <li><a href="/water-damage/california/" style="color:#60a5fa;font-weight:700;text-decoration:none;font-size:0.82rem">California Water Damage</a></li>
          <li><a href="/water-damage/texas/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Texas Water Damage</a></li>
          <li><a href="/water-damage/florida/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Florida Water Damage</a></li>
          <li><a href="/water-damage/new-york/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">New York Water Damage</a></li>
          <li><a href="/water-damage/pennsylvania/" style="color:#94a3b8;text-decoration:none;font-size:0.82rem">Pennsylvania Water Damage</a></li>
          <li><a href="/service-areas/" style="color:#60a5fa;font-weight:700;font-size:0.82rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem">
            <span>All 50 States Hub →</span>
          </a></li>
        </ul>
      </div>
    </div>

    <!-- 50 States Bar (Reference Site Pattern) -->
    <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid #0f172a">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
        <h5 style="color:#ffffff;font-size:0.78rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin:0">Water Damage Restoration Service by State</h5>
        <a href="/service-areas/" style="color:#60a5fa;font-size:0.78rem;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:0.25rem">
          <span>Explore All 50 States</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem 0.75rem;font-size:0.75rem;color:#64748b">
        {ALL_STATES.map((st) => (
          <a
            href={`/water-damage/${st.slug}/`}
            style="color:#64748b;text-decoration:none;transition:color 0.15s ease"
            class="hover:text-slate-200"
            title={`Water Damage Restoration in ${st.name}`}
          >
            {st.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Legal Disclaimer -->
    <div style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.06);font-size:0.75rem;color:#64748b;line-height:1.6">
      <strong>Disclaimer:</strong> Rapid Water Rescue Pros is an emergency water damage mitigation, extraction, and disaster recovery dispatch network. All plumbing disconnections, structural drying procedures, and water mitigation services are executed by licensed, certified, and insured restoration professionals adhering to IICRC S500 standards and applicable building codes.
    </div>

    <!-- Bottom Copyright -->
    <div style="margin-top:1.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1rem;font-size:0.75rem;color:#64748b">
      <div>© 2026 RapidWaterRescuePros.com. All rights reserved.</div>
      <div style="display:flex;gap:1.25rem">
        <a href="/privacy-policy/" style="color:#64748b;text-decoration:none">Privacy Policy</a>
        <a href="/terms-of-service/" style="color:#64748b;text-decoration:none">Terms of Service</a>
        <a href="/sitemap.xml" style="color:#64748b;text-decoration:none">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 900px) {
    .footer-columns-wrap {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 600px) {
    .footer-columns-wrap {
      grid-template-columns: 1fr !important;
    }
  }
</style>
