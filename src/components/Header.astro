---
import { BUSINESS_INFO, SERVICES, ALL_STATES } from '../data/siteData';

interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;
---

<!-- Top Announcement Bar -->
<div class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-bar-badge">
      <span class="top-bar-pulse"></span>
      <span>24/7 Rapid Emergency Response · Certified Water Extraction Specialists</span>
    </div>
    <div style="display:flex;align-items:center;gap:1.5rem">
      <a href={BUSINESS_INFO.phoneTel} class="top-bar-phone">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        <span>{BUSINESS_INFO.phoneFormatted}</span>
      </a>
      <span style="font-size:0.8rem;color:rgba(255,255,255,0.6)">Avg Dispatch: Under 60 Min</span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" title="Rapid Water Rescue Pros - Home">
      <div class="brand-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
      </div>
      <div class="brand-text">
        Rapid Water <span>Rescue Pros</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Main Navigation">
      <ul class="nav-links">
        <li class="nav-item">
          <a href="/" class={`nav-link ${activePath === '/' ? 'active' : ''}`}>Home</a>
        </li>

        <!-- Services Dropdown -->
        <li class="nav-item">
          <a href="/services/" class="nav-link">
            <span>Services</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
          </a>
          <div class="dropdown-menu">
            <a href="/services/" class="dropdown-item" style="font-weight:700;color:var(--primary);border-bottom:1px solid var(--border-light);margin-bottom:0.25rem">View All Services →</a>
            {SERVICES.map((s) => (
              <a href={`/services/${s.slug}/`} class="dropdown-item">
                {s.name}
              </a>
            ))}
          </div>
        </li>

        <!-- Service Areas Dropdown -->
        <li class="nav-item">
          <a href="/service-areas/" class="nav-link">
            <span>Service Areas</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
          </a>
          <div class="dropdown-menu" style="min-width:320px;max-height:420px;overflow-y:auto">
            <a href="/service-areas/" class="dropdown-item" style="font-weight:700;color:var(--primary);border-bottom:1px solid var(--border-light);margin-bottom:0.25rem">View All 50 States Hub →</a>
            <div style="padding:0.4rem 1.25rem;font-size:0.75rem;text-transform:uppercase;color:var(--secondary);font-weight:800;letter-spacing:0.05em">Featured State</div>
            <a href="/water-damage/california/" class="dropdown-item" style="font-weight:700;color:#2563eb;background:#eff6ff">California (All Cities) →</a>
            <div style="padding:0.4rem 1.25rem;font-size:0.75rem;text-transform:uppercase;color:var(--text-muted);font-weight:800;letter-spacing:0.05em;margin-top:0.4rem">All 50 States</div>
            {ALL_STATES.map((st) => (
              <a href={`/water-damage/${st.slug}/`} class="dropdown-item">
                {st.name} ({st.abbr})
              </a>
            ))}
          </div>
        </li>

        <li class="nav-item">
          <a href="/about-us/" class={`nav-link ${activePath === '/about-us/' ? 'active' : ''}`}>About Us</a>
        </li>
        <li class="nav-item">
          <a href="/blog/" class={`nav-link ${activePath === '/blog/' ? 'active' : ''}`}>Blog</a>
        </li>
        <li class="nav-item">
          <a href="/contact-us/" class={`nav-link ${activePath === '/contact-us/' ? 'active' : ''}`}>Contact</a>
        </li>
      </ul>

      <!-- Emergency Red CTA Button -->
      <div class="header-cta-group">
        <a href={BUSINESS_INFO.phoneTel} class="btn btn-emergency">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <span>Call Now</span>
        </a>
      </div>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle mobile menu" aria-expanded="false">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div style="margin-bottom:1.5rem">
    <a href={BUSINESS_INFO.phoneTel} class="btn btn-emergency" style="width:100%;text-align:center">
      Call 24/7: {BUSINESS_INFO.phoneFormatted}
    </a>
  </div>
  <ul class="mobile-nav-list">
    <li><a href="/" class="mobile-nav-link">Home</a></li>
    <li><a href="/services/" class="mobile-nav-link">Our Services</a></li>
    {SERVICES.map((s) => (
      <li style="padding-left:1rem"><a href={`/services/${s.slug}/`} style="color:var(--text-muted);font-size:0.95rem;display:block;padding:0.35rem 0">{s.name}</a></li>
    ))}
    <li style="margin-top:0.5rem"><a href="/service-areas/" class="mobile-nav-link">Service Areas Directory</a></li>
    <li style="padding-left:1rem"><a href="/water-damage/california/" style="color:#2563eb;font-weight:700;display:block;padding:0.35rem 0">California Coverage →</a></li>
    <li><a href="/about-us/" class="mobile-nav-link">About Us</a></li>
    <li><a href="/blog/" class="mobile-nav-link">Blog & Resource Guides</a></li>
    <li><a href="/contact-us/" class="mobile-nav-link">Contact Us</a></li>
  </ul>
</div>

<script is:inline>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }
</script>
