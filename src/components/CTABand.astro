---
import { BUSINESS_INFO } from '../data/siteData';

interface Props {
  headline?: string;
  subtext?: string;
}

const {
  headline = "Dealing with Standing Flood Water or a Leaking Water Heater?",
  subtext = "Every hour counts. Our emergency water extraction units are operational 24/7/365 with average on-site arrival times under 60 minutes."
} = Astro.props;
---

<section class="cta-band">
  <div class="container text-center">
    <h2>{headline}</h2>
    <p>{subtext}</p>
    <div class="cta-band-actions">
      <a href={BUSINESS_INFO.phoneTel} class="btn btn-white-cta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        <span>Call Now: {BUSINESS_INFO.phoneFormatted}</span>
      </a>
      <a href="/contact-us/" class="btn btn-outline-white" style="font-weight:700">
        <span>Request Online Dispatch →</span>
      </a>
    </div>
  </div>
</section>
