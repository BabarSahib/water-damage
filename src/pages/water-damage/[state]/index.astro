---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TrustStrip from '../../../components/TrustStrip.astro';
import { BUSINESS_INFO, SERVICES, ALL_STATES } from '../../../data/siteData';
import { getStateCities } from '../../../data/citiesHelper';
import { getRegionalProfile } from '../../../data/regionalClimate';

export async function getStaticPaths() {
  return ALL_STATES.map((state) => ({
    params: { state: state.slug },
    props: { currentState: state }
  }));
}

const { currentState } = Astro.props;
const stateData = getStateCities(currentState.slug);
const stateCities = stateData ? stateData.cities : [];
const regional = getRegionalProfile(currentState.slug);

// Top featured cities
const featuredCities = stateCities.slice(0, 12);

const stateFaqs = [
  {
    q: `How quickly can technicians arrive for water emergencies in ${currentState.name}?`,
    a: `Our emergency dispatch vehicles are positioned throughout ${currentState.name} near key transit corridors, maintaining an average arrival time under 60 minutes for water emergencies, burst pipes, and severe flooding.`
  },
  {
    q: `Are your water extraction technicians licensed and insured in ${currentState.name}?`,
    a: `Yes. All service personnel operating in ${currentState.name} carry comprehensive commercial liability insurance, full state licensing, and IICRC S500 certifications for structural water damage mitigation.`
  },
  {
    q: `What causes water emergencies most frequently in ${currentState.name}?`,
    a: `${regional.climateTitle}: ${regional.climateDesc} ${regional.localFaqAnswer}`
  },
  {
    q: `Do you work with ${currentState.name} homeowners insurance companies?`,
    a: `Yes. We work directly with all major insurance providers serving ${currentState.name}, including State Farm, Farmers, Allstate, Travelers, and USAA. We provide thermal moisture maps, itemized estimates, and direct billing.`
  },
  {
    q: `Do you handle both residential and commercial properties across ${currentState.name}?`,
    a: `Yes. We provide emergency extraction for single-family residences, commercial retail centers, and industrial facilities in all ${stateCities.length} communities throughout ${currentState.name}.`
  }
];

const pageTitle = `Emergency Water Extraction & Water Damage Restoration in ${currentState.name} | 24/7 Hotline`;
const pageDesc = `Fast 24/7 emergency water extraction, flood damage mitigation & structural drying across ${currentState.name}. Serving all ${stateCities.length} cities. Under 60-min response. Call (866) 751-9896.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": stateFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

const stateMapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(currentState.name + ', USA')}&t=&z=7&ie=UTF8&iwloc=&output=embed`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalPath={`/water-damage/${currentState.slug}/`}
  localState={currentState.abbr}
>
  <!-- 2-Level Breadcrumb (Home > State) -->
  <Breadcrumb items={[
    { label: "Home", url: "/" },
    { label: currentState.name, url: `/water-damage/${currentState.slug}/` }
  ]} />

  <!-- Hero Section (Original Signature Dark Blue Theme) -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.25rem;align-items:flex-start">
          <div class="ref-hero-badge-1">
            <span class="badge-dot"></span>
            <span>24/7 Priority Emergency Response Active</span>
          </div>
          <div class="ref-hero-badge-2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span>{stateCities.length} COMMUNITIES SERVED ACROSS {currentState.name.toUpperCase()}</span>
          </div>
        </div>

        <h1>Emergency Water Extraction & Flood Damage Mitigation in <span class="hero-city-accent">{currentState.name}</span></h1>
        
        <p class="hero-subtitle">
          When an indoor water heater ruptures, frozen pipes burst, or heavy rains flood your property in {currentState.name}, our certified extraction specialists arrive on site in 60 minutes or less. We pump out standing water, disconnect failed plumbing, and dry structural framing to prevent toxic mold.
        </p>

        <div class="hero-actions">
          <a href={BUSINESS_INFO.phoneTel} class="btn btn-emergency">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <span>Call {currentState.name} Hotline: {BUSINESS_INFO.phoneFormatted}</span>
          </a>
          <a href={BUSINESS_INFO.phoneTel} class="btn btn-outline-white">
            <span>Request Fast Assessment</span>
          </a>
        </div>

        <div class="hero-highlights">
          <div class="hero-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--secondary)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>{stateCities.length} Communities Served Statewide</span>
          </div>
          <div class="hero-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--secondary)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>Under 60-Minute Response Guarantee</span>
          </div>
          <div class="hero-highlight-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--secondary)"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <span>Direct Home Insurance Billing</span>
          </div>
        </div>
      </div>

      <!-- Hero Media (Matching Reference Site Hero Image) -->
      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/hero_water_extraction.jpg"
            alt={`Professional technician performing emergency water extraction in ${currentState.name}`}
            width="900"
            height="675"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-float-dispatch">
            <span class="pulse-dot"></span>
            <span>Live 24/7: {BUSINESS_INFO.phoneFormatted}</span>
          </div>
          <div class="hero-same-day-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fb923c"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            <span>{currentState.name} Rapid Extraction</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- Main Content Layout -->
  <div class="ref-page-wrap">
    <div class="container ref-main-content">

      <!-- 1. Community Profile (Dark Card) -->
      <section class="ref-community-card">
        <h2 class="ref-community-h2">{currentState.name} Statewide Emergency Response Profile</h2>
        <p class="ref-community-p">
          Rapid Water Rescue Pros maintains an extensive network of mobile disaster response units stationed near key interstate corridors across {currentState.name}. Covering all {stateCities.length} incorporated cities and towns, our certified specialists are equipped to handle sudden multi-room floods, burst plumbing mains, sewage overflows, and structural drying.
        </p>

        <div class="ref-stats-grid">
          <div class="ref-stat-box">
            <div class="ref-stat-title">Cities Covered</div>
            <div class="ref-stat-number">{stateCities.length.toLocaleString('en-US')}</div>
            <div class="ref-stat-note">Towns & Municipalities</div>
          </div>
          <div class="ref-stat-box">
            <div class="ref-stat-title">Average Dispatch</div>
            <div class="ref-stat-number" style="color:#60a5fa">Under 60 Min</div>
            <div class="ref-stat-note">Rapid Priority Units</div>
          </div>
          <div class="ref-stat-box">
            <div class="ref-stat-title">Certifications</div>
            <div class="ref-stat-number">IICRC S500</div>
            <div class="ref-stat-note">Licensed & Insured</div>
          </div>
          <div class="ref-stat-box">
            <div class="ref-stat-title">Dispatch Desk</div>
            <div class="ref-stat-number" style="font-size:1.15rem">24/7/365</div>
            <div class="ref-stat-note">Toll-Free Nationwide</div>
          </div>
        </div>
      </section>

      <!-- 2. Regional Climate & Environmental Risks -->
      <section class="ref-issues-card">
        <div class="ref-card-header">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <h2>{regional.climateTitle} in {currentState.name}</h2>
        </div>
        <p style="font-size:0.92rem;color:#475569;line-height:1.65;margin:0">
          {regional.climateDesc}
        </p>

        <div class="ref-issues-grid">
          <div class="ref-issue-pill">
            <span class="ref-issue-badge">!</span>
            <span>Freeze-thaw pipe stress & sub-zero supply line ruptures</span>
          </div>
          <div class="ref-issue-pill">
            <span class="ref-issue-badge">!</span>
            <span>Intense seasonal rain surges, saturated crawlspaces & foundation pooling</span>
          </div>
          <div class="ref-issue-pill">
            <span class="ref-issue-badge">!</span>
            <span>Water heater tank corrosion and sudden bottom weld shearing</span>
          </div>
          <div class="ref-issue-pill">
            <span class="ref-issue-badge">!</span>
            <span>Hydrostatic slab pressure and foundation moisture penetration</span>
          </div>
        </div>
      </section>

      <!-- 3. Featured Cities -->
      {featuredCities.length > 0 && (
        <section class="ref-surround-card">
          <h3 class="ref-surround-title">Popular {currentState.name} Metropolitan Hubs</h3>
          <div class="ref-pills-wrap">
            {featuredCities.map((c) => (
              <a href={`/water-damage/${currentState.slug}/${c.slug}/`} class="ref-city-pill" style="font-weight:600">
                {c.name}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- 4. Complete City Directory (All Cities in this State) -->
      <section class="ref-issues-card" style="gap:1rem">
        <div class="ref-card-header">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="10" r="3"></circle>
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
          </svg>
          <h2>All {stateCities.length} Cities in {currentState.name}</h2>
        </div>
        <p style="font-size:0.85rem;color:#64748b;margin:0">
          Select your city below to view local dispatch times, environmental risk factors, and 24/7 water restoration contacts:
        </p>

        <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(180px, 1fr));gap:0.5rem;max-height:480px;overflow-y:auto;padding:1rem;border:1px solid #e2e8f0;border-radius:0.75rem;background:#f8fafc">
          {stateCities.map((c) => (
            <a href={`/water-damage/${currentState.slug}/${c.slug}/`} style="font-size:0.82rem;color:#334155;text-decoration:none;padding:0.25rem 0.5rem;border-radius:4px;transition:all 0.15s ease" class="hover:bg-blue-100 hover:text-blue-700">
              {c.name}
            </a>
          ))}
        </div>
      </section>

      <!-- 5. Services Grid -->
      <section class="ref-services-section">
        <div class="ref-services-header">
          <div>
            <h2>Water Damage Restoration Services Throughout {currentState.name}</h2>
            <p>Certified emergency extraction and structural drying solutions</p>
          </div>
          <a href="/services/" class="ref-all-link">
            <span>All Services</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="ref-services-grid">
          {SERVICES.map((service) => (
            <div class="ref-service-box">
              <div class="ref-service-thumb">
                <img
                  src={service.image}
                  alt={`${service.name} in ${state.name}`}
                  loading="lazy"
                  width="600"
                  height="375"
                />
                <span class="ref-service-badge">24/7 Dispatch</span>
              </div>
              <div class="ref-service-body">
                <h3>{service.name}</h3>
                <p>{service.shortDesc}</p>
              </div>
              <div class="ref-service-footer">
                <a href={`/services/${service.slug}/`} class="ref-service-link">
                  <span>Learn More</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>
                <a href={BUSINESS_INFO.phoneTel} class="ref-service-call">Call</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. State FAQs -->
      <section class="ref-faqs-card">
        <div class="ref-card-header">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <h2>{currentState.name} Water Damage FAQs</h2>
        </div>

        <div style="margin-top:0.5rem">
          {stateFaqs.map((faq) => (
            <details class="ref-faq-item">
              <summary class="ref-faq-q">
                <span>{faq.q}</span>
                <svg class="ref-faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="ref-faq-a">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Coverage Map Section (Placed After FAQs) -->
      <section class="ref-map-section text-center">
        <span class="ref-section-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z"/></svg>
          Coverage Map
        </span>
        <h2 class="ref-section-h2">{currentState.name} Service Area</h2>
        <p class="ref-section-sub">
          Rapid Water Rescue Pros maintains 24/7 disaster response coverage across all {stateCities.length} incorporated communities in {currentState.name}.
        </p>

        <div class="ref-map-frame">
          <iframe
            title={`Statewide Coverage Map for ${currentState.name}`}
            src={stateMapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <!-- 7. High-Impact Callout Banner -->
      <section class="ref-bottom-banner">
        <div class="ref-banner-glow"></div>
        <div style="position:relative;z-index:2;max-width:680px">
          <div class="ref-banner-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            </svg>
            <span>Emergency Dispatch Statewide</span>
          </div>
          <h3 class="ref-banner-h3">Need Immediate Water Extraction in {currentState.name}?</h3>
          <p class="ref-banner-p">
            Call (866) 751-9896 to connect directly with our emergency response team serving all {stateCities.length} communities throughout {currentState.name}.
          </p>
          <div class="ref-banner-tags">
            <div class="ref-banner-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>Prompt 45-60 Min Response</span>
            </div>
            <div class="ref-banner-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
              <span>No Obligation Inquiries</span>
            </div>
            <div class="ref-banner-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              <span>Direct Insurance Billing</span>
            </div>
          </div>
        </div>

        <div class="ref-banner-cta" style="position:relative;z-index:2">
          <a href={BUSINESS_INFO.phoneTel} class="ref-call-btn" style="padding:1rem 2.2rem;font-size:1.15rem" aria-label={`Call (866) 751-9896 for emergency assistance in ${currentState.name}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{BUSINESS_INFO.phoneFormatted}</span>
          </a>
          <span style="font-size:0.75rem;color:#94a3b8;margin-top:0.4rem">Toll-free customer line</span>
        </div>
      </section>

    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
