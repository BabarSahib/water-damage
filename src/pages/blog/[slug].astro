---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTABand from '../../components/CTABand.astro';
import { BLOG_POSTS } from '../../data/blogPosts';
import { BUSINESS_INFO } from '../../data/siteData';

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const otherPosts = BLOG_POSTS.filter((p) => p.slug !== post.slug).slice(0, 3);

// Article Schema JSON-LD
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.metaDesc,
  "image": post.image,
  "author": {
    "@type": "Person",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": BUSINESS_INFO.name,
    "logo": {
      "@type": "ImageObject",
      "url": "https://rapidwaterrescuepros.com/assets/logo.png"
    }
  },
  "datePublished": post.publishDate,
  "dateModified": post.publishDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://rapidwaterrescuepros.com/blog/${post.slug}/`
  }
};
---

<BaseLayout title={`${post.title} | Rapid Water Rescue Pros`} description={post.metaDesc} canonicalPath={`/blog/${post.slug}/`} ogImage={post.image}>
  <Breadcrumb items={[
    { label: "Home", url: "/" },
    { label: "Blog", url: "/blog/" },
    { label: post.title, url: `/blog/${post.slug}/` }
  ]} />

  <!-- Post Header -->
  <article class="section" style="padding-top:2rem">
    <div class="container container-narrow">
      <header style="margin-bottom:2.5rem">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;flex-wrap:wrap">
          <span class="badge badge-secondary">{post.category}</span>
          <span style="font-size:0.85rem;color:var(--text-muted)">Published: {post.publishDate}</span>
          <span style="font-size:0.85rem;color:var(--text-muted)">· {post.readTime}</span>
        </div>

        <h1 style="font-size:clamp(1.9rem, 3.5vw, 2.75rem);line-height:1.2;margin-bottom:1.25rem">
          {post.title}
        </h1>

        <div style="display:flex;align-items:center;gap:1rem;padding-top:1rem;border-top:1px solid var(--border-light)">
          <div style="width:46px;height:46px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem">
            {post.author.charAt(0)}
          </div>
          <div>
            <div style="font-weight:700;color:var(--primary)">{post.author}</div>
            <div style="font-size:0.82rem;color:var(--text-muted)">Certified Restoration Lead · Rapid Water Rescue Pros</div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      <div style="margin-bottom:3rem;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-md);max-height:450px">
        <img
          src={post.image}
          alt={post.title}
          style="width:100%;height:100%;object-fit:cover"
        />
      </div>

      <!-- Post Body Content -->
      <div class="article-content" style="font-size:1.05rem;line-height:1.8;color:var(--text-body)">
        <Fragment set:html={post.content} />
      </div>

      <!-- Author Bio Box -->
      <div style="background:var(--bg-light);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:2rem;margin:3.5rem 0;display:flex;gap:1.5rem;align-items:center">
        <div style="width:65px;height:65px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.5rem;flex-shrink:0">
          {post.author.charAt(0)}
        </div>
        <div>
          <h4 style="margin-bottom:0.35rem">Written by {post.author}</h4>
          <p style="font-size:0.9rem;color:var(--text-muted);margin:0;line-height:1.6">
            Technical director and senior restoration supervisor at Rapid Water Rescue Pros. Specializes in psychrometrics, structural wood drying, commercial extraction systems, and disaster insurance billing.
          </p>
        </div>
      </div>
    </div>
  </article>

  <!-- Optional FAQs -->
  {post.faqs && post.faqs.length > 0 && (
    <FAQAccordion
      title="Article FAQs"
      subtitle="Frequently asked questions related to this guide."
      faqs={post.faqs}
    />
  )}

  <!-- Related Posts -->
  <section class="section bg-light">
    <div class="container">
      <div class="text-center section-header">
        <span class="badge badge-secondary">Keep Learning</span>
        <h2>Related Mitigation Guides</h2>
      </div>

      <div class="cards-grid">
        {otherPosts.map((op) => (
          <div class="service-card">
            <span style="font-size:0.75rem;color:var(--secondary);font-weight:700;margin-bottom:0.4rem">{op.category}</span>
            <h3 style="font-size:1.15rem"><a href={`/blog/${op.slug}/`}>{op.title}</a></h3>
            <p style="font-size:0.88rem;color:var(--text-muted)">{op.excerpt}</p>
            <a href={`/blog/${op.slug}/`} class="card-link" style="font-size:0.9rem">
              <span>Read Post →</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand headline="Need Immediate Water Removal Support?" subtext="Our live emergency dispatch desk answers around the clock with zero hold time." />

  <!-- Inject Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
